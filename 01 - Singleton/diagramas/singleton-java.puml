@startuml
title Singleton en Java (clase Logger)
class Logger {
  - {static} INSTANCIA : Logger
  - logCount : int
  - Logger()
  + {static} getInstancia() : Logger
  + log(mensaje : String)
}
class Principal
Principal ..> Logger : getInstancia()
note right of Logger
  El constructor privado impide
  new Logger() desde fuera.
end note
@enduml
